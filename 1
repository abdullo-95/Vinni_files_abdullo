#include <stdio.h>    // printf, fscanf, fopen, fclose, FILE — ввод/вывод и файлы
#include <locale.h>   // setlocale — для корректного вывода русских букв
#define AR_LEN 100    // макрос: максимальный размер массива = 100

// Структура "Время" — часы и минуты
struct Time {
    int h;   // часы
    int m;   // минуты
};

// Структура "Рейс" — номер автобуса, время, станция
struct Trip {
    char bus_no[20];    // строка для номера автобуса (до 19 символов + '\0')
    struct Time time;   // ВЛОЖЕННАЯ структура Time
    char station[50];   // строка для названия станции (до 49 символов)
};

int main(void) {
    setlocale(LC_ALL, "");   // включаем локаль системы — чтобы работала кириллица

    struct Trip ar[AR_LEN];  // массив из 100 структур Trip (куда читаем данные)
    FILE *f_in = fopen("in.txt", "r");  // открываем файл in.txt на чтение ("r" = read)
    struct Trip trip;        // временная переменная для одной записи
    int count = 0;           // счётчик уже прочитанных записей

    // Цикл чтения данных из файла
    while (
        count < AR_LEN &&                  // 1) не переполнить массив (макс 100)
        4 == fscanf(f_in, "%s %d.%d %s",   // 2) успешно прочитать ровно 4 поля
            trip.bus_no,        // строка — имя массива уже указатель, & не нужен
            &trip.time.h,       // int — нужен адрес, ставим &
            &trip.time.m,       // int — нужен адрес, ставим &
            trip.station)       // строка — & не нужен
    ) {
        ar[count] = trip;   // копируем прочитанную запись в массив
        ++count;            // увеличиваем счётчик
    }

    fclose(f_in);   // закрываем файл — освобождаем ресурс

    int i;   // объявление счётчика (в стиле C89 — до цикла)
    // Проходим по всем прочитанным записям и печатаем их
    for (i = 0; i < count; ++i) {
        printf("%s %d.%d %s\n",       // формат такой же, как в файле
            ar[i].bus_no,             // номер автобуса
            ar[i].time.h,             // часы
            ar[i].time.m,             // минуты
            ar[i].station);           // станция
    }

    return 0;   // успешное завершение программы
}
