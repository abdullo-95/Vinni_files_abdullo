/*
Структура — это составной тип данных.
Представь, что тебе нужно хранить информацию о человеке: имя, возраст и зарплату.
Без структуры пришлось бы создавать три отдельные переменные. 
Со структурой ты создаёшь один «контейнер», в котором лежат все три поля .

Как определить структуру:
#include <stdio.h>

// Определение структуры (создание шаблона)
struct employee {
    char *name;   // указатель на строку
    int age;      // целое число
    double salary;// дробное число
};

int main(void) {
    // Создание переменной типа struct employee
    struct employee sam = {"Sam", 23, 4500.0};
    
    // Доступ к полям через точку
    printf("Name: %s\n", sam.name);
    printf("Age: %d\n", sam.age);
    printf("Salary: %.2f\n", sam.salary);
    
    return 0;
}
Ключевые моменты:

Доступ к полям: Используется оператор . (точка) — sam.name, sam.age .

Инициализация: Значения полей перечисляются в фигурных скобках {} в том порядке, в котором они объявлены в структуре .

Указатели на структуры: Если у тебя есть указатель на структуру, доступ к полям осуществляется через -> (стрелка):

c
struct employee *p = &sam;
printf("%s", p->name); // то же самое, что (*p).name
Это часто используется для передачи структур в функции без копирования всех данных .

Зачем нужен typedef:
Чтобы каждый раз не писать struct employee, можно создать псевдоним:

c
typedef struct {
    char *name;
    int age;
} employee;

// Теперь можно писать просто:
employee tom = {"Tom", 38};
Это делает код чище и короче .

📁 Работа с файлами в C
В C файл рассматривается как поток байтов. Для работы с файлами используется указатель на специальную структуру FILE, которая определена в stdio.h .

Основные шаги:

Открыть файл с помощью fopen(). Нужно указать имя и режим ("r" — чтение, "w" — запись/перезапись, "a" — добавление) .

Проверить, успешно ли открылся файл (функция вернёт NULL, если ошибка).

Выполнить операции чтения или записи.

Закрыть файл с помощью fclose().

Пример записи и чтения текстового файла:

c
#include <stdio.h>

int main(void) {
    // --- ЗАПИСЬ ---
    FILE *fp = fopen("data.txt", "w"); // открыть на запись
    if (fp == NULL) {
        printf("Не удалось открыть файл!\n");
        return 1;
    }
    
    fprintf(fp, "Hello METANIT.COM!\n"); // записать строку
    fclose(fp); // закрыть
    
    // --- ЧТЕНИЕ ---
    fp = fopen("data.txt", "r"); // открыть на чтение
    if (fp == NULL) {
        printf("Файл не найден!\n");
        return 1;
    }
    
    char buffer[100];
    while (fgets(buffer, sizeof(buffer), fp) != NULL) { // читать построчно
        printf("%s", buffer);
    }
    fclose(fp);
    
    return 0;
}
Полезные функции для работы с файлами:

Функция	Что делает
fprintf(fp, "...", ...)	Форматированный вывод в файл (как printf, но в файл)
fgets(buf, size, fp)	Читает строку из файла (безопасно)
fwrite(ptr, size, count, fp)	Записывает блок данных (для бинарных файлов) 
fread(ptr, size, count, fp)	Читает блок данных (для бинарных файлов) 
feof(fp)	Проверяет, достигнут ли конец файла/
